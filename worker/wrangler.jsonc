{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "secubuzz-push",
	"account_id": "36eb47dcba495d7d872a2647755f6bde",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "secubuzz.com",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "secubuzz-push-db",
			"database_id": "13e7169f-7237-46a3-97fd-d0e4762b94e2"
		}
	],
	"triggers": {
		"crons": ["17 */4 * * *"]
	},
	"assets": {
		"directory": "../website/dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	}
}