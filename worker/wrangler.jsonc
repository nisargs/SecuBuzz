{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "secubuzz-push",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "secubuzz-push-db",
			"database_id": "13e7169f-7237-46a3-97fd-d0e4762b94e2"
		}
	],
	"triggers": {
		"crons": ["17 */4 * * *"]
	}
}