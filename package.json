  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "update:prod": "eas update --platform android --branch production --environment production --auto",
    "web:dev": "npm run --prefix website dev",
    "web:build": "node scripts/sync_website_data.mjs && npm run --prefix website build",
