{
  "name": "secubuzz",
  "version": "1.1.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/exo": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.147.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "update:prod": "eas update --platform android --branch production --environment production --auto",
    "web:dev": "npm run --prefix website dev",
    "web:build": "node scripts/sync_website_data.mjs && npm run --prefix website build",
    "worker:dev": "npm run --prefix worker dev",
    "worker:deploy": "npm run --prefix worker deploy",
    "deploy:web": "npm run web:build && npm run worker:deploy",
    "analytics": "node scripts/cf_analytics.mjs",
    "analytics:repeat": "node scripts/track_repeat_users.mjs",
    "watchdog": "node scripts/watchdog.mjs",
    "verify:feed": "node scripts/verify_feed_freshness.mjs",
    "feed:sync": "node scripts/sync_website_data.mjs && npx wrangler r2 object put secubuzz-feed/feed.json --file ./feed.json --remote",
    "test:push": "node scripts/test_push_targeting.mjs",
    "track:push": "node scripts/track_broadcast_clicks.mjs",
    "verify:slugs": "node scripts/verify_slug_collisions.mjs",
    "verify:radar": "node scripts/verify_vendor_radar.mjs"
  },
  "private": true
}
